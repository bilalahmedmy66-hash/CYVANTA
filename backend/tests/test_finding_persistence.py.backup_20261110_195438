def test_persistence_requires_clean_session(db):
    db.query(PlatformDetectionFinding).count()

    with pytest.raises(RuntimeError):
        persist_detection_findings(
            db,
            [make_finding()],
        )

    db.rollback()

    assert db.query(PlatformDetectionFinding).count() == 0
